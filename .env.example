# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ── Auth (required) ────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-32-byte-random-hex
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=

# ── OAuth (optional — Google / Microsoft login) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── HuggingFace model cache (optional — defaults to ~/.cache/phishnot) ─────────
# HF_CACHE_DIR=/path/to/cache

# ── LLM providers for the Analyst Chat (optional) ──────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# ── Threat intelligence feeds (optional) ───────────────────────────────────────
VT_API_KEY=
OTX_API_KEY=
PHISHTANK_APP_KEY=
